# Environment variables for Zentity development
# Copy this file to .env and customize as needed

# Elasticsearch version
ELASTICSEARCH_VERSION=8.17.0

# OpenSearch version  
OPENSEARCH_VERSION=2.17.0

# Zentity plugin version
ZENTITY_VERSION=1.8.3

# Build directory (used by integration tests)
BUILD_DIRECTORY=./target

# Development options
BUILD_PLUGIN=true
LOAD_DATA=true

# Memory settings (adjust based on your system)
ES_HEAP_SIZE=1g
OPENSEARCH_HEAP_SIZE=1g

# Ports (change if you have conflicts)
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
OPENSEARCH_PORT=9201
OPENSEARCH_TRANSPORT_PORT=9301
KIBANA_PORT=5601
OPENSEARCH_DASHBOARDS_PORT=5602 